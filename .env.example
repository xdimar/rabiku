# Neon Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Cloudflare R2 Object Storage (Media Uploads)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="rabiku-media"
R2_PUBLIC_URL="https://your-public-r2-url.r2.dev"

# Authentication & Production Domain
JWT_SECRET="your-super-secret-jwt-key-for-rabiku-production"
NEXT_PUBLIC_APP_URL="https://rabiku.my.id"
